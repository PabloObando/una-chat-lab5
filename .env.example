# Copy to .env for local login. Do not commit .env.
# Leave AUTH0_DOMAIN and AUTH0_CLIENT_ID empty and the chat stays open for tests.

AUTH0_DOMAIN=dev-uioi05vkuozks1ry.us.auth0.com
AUTH0_CLIENT_ID=XAihE1D0SLEmDAkyQVs1CxWxQJdf1Hmn
APP_BASE_URL=http://localhost:3000

# Postgres URI for the una_chat_backend role. TLS is required.
# Direct host (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# IPv4 session pooler: postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=Hjsh35542HSYAkdks98

# Do not set AUTH0_CLIENT_SECRET. The backend reads
# una_chat_auth0_client_secret from Supabase Vault at startup.